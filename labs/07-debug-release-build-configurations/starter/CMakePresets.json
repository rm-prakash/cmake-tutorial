{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {"name": "ninja-debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/ninja-debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "ninja-release", "generator": "Ninja", "binaryDir": "${sourceDir}/build/ninja-release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}},
    {"name": "ninja-multi", "generator": "Ninja Multi-Config", "binaryDir": "${sourceDir}/build/ninja-multi", "cacheVariables": {"BUILD_TESTING": "ON"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "ninja-debug"},
    {"name": "release", "configurePreset": "ninja-release"},
    {"name": "multi-debug", "configurePreset": "ninja-multi", "configuration": "Debug"},
    {"name": "multi-release", "configurePreset": "ninja-multi", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "ninja-debug", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "ninja-release", "output": {"outputOnFailure": true}},
    {"name": "multi-debug", "configurePreset": "ninja-multi", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "multi-release", "configurePreset": "ninja-multi", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
