function(embeddedcore_resolve_openssl)
  if(EMBEDDEDCORE_OPENSSL_ROOT)
    if(NOT IS_DIRECTORY "${EMBEDDEDCORE_OPENSSL_ROOT}")
      message(FATAL_ERROR "Pinned OpenSSL root does not exist: ${EMBEDDEDCORE_OPENSSL_ROOT}")
    endif()
    file(REAL_PATH "${EMBEDDEDCORE_OPENSSL_ROOT}" _prefix)
    set(OPENSSL_ROOT_DIR "${_prefix}")
    # Constrain discovery to the supplied prefix. FindOpenSSL is a CMake module,
    # and its result variables vary by platform; verify resolved files below.
    set(OPENSSL_USE_STATIC_LIBS TRUE)
  endif()
  find_package(OpenSSL REQUIRED COMPONENTS Crypto)
  if(NOT TARGET OpenSSL::Crypto)
    message(FATAL_ERROR "FindOpenSSL did not provide OpenSSL::Crypto")
  endif()
  if(EMBEDDEDCORE_OPENSSL_ROOT)
    foreach(_path IN ITEMS "${OPENSSL_INCLUDE_DIR}" "${OPENSSL_CRYPTO_LIBRARY}")
      if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "OpenSSL discovery returned an invalid path: ${_path}")
      endif()
      file(REAL_PATH "${_path}" _resolved)
      cmake_path(IS_PREFIX _prefix "${_resolved}" NORMALIZE _inside)
      if(NOT _inside)
        message(FATAL_ERROR "OpenSSL escaped requested prefix: ${_resolved}; expected under ${_prefix}")
      endif()
    endforeach()
  endif()
  message(STATUS "OpenSSL found ${OPENSSL_VERSION}: ${OPENSSL_CRYPTO_LIBRARY}")
  # Discovery and linking do NOT establish FIPS or cryptographic approval.
endfunction()
