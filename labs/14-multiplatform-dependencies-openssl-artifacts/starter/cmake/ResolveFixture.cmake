function(embeddedcore_resolve_fixture)
  if(NOT EMBEDDEDCORE_ARTIFACT_ROOT)
    message(FATAL_ERROR "Fixture root missing. Build fixture first; pass -DEMBEDDEDCORE_ARTIFACT_ROOT=...")
  endif()
  file(REAL_PATH "${EMBEDDEDCORE_ARTIFACT_ROOT}" _root)
  set(_inc "${_root}/include")
  set(_lib "${_root}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}telemetrycodec${CMAKE_STATIC_LIBRARY_SUFFIX}")
  set(_id_file "${_root}/metadata/target-id.txt")
  set(_hash_file "${_root}/metadata/libsha256.txt")
  foreach(_needed IN ITEMS "${_inc}/telemetrycodec/codec.hpp" "${_lib}" "${_id_file}" "${_hash_file}")
    if(NOT EXISTS "${_needed}")
      message(FATAL_ERROR "Incomplete dependency package: ${_needed}")
    endif()
  endforeach()
  file(READ "${_id_file}" _recorded_id)
  string(STRIP "${_recorded_id}" _recorded_id)
  if(NOT _recorded_id STREQUAL EMBEDDEDCORE_TARGET_ID)
    message(FATAL_ERROR "ABI/OS mismatch: package=${_recorded_id}, target=${EMBEDDEDCORE_TARGET_ID}")
  endif()
  file(READ "${_hash_file}" _expected)
  string(STRIP "${_expected}" _expected)
  if(NOT _expected MATCHES "^[a-fA-F0-9]{64}$")
    # CMake regex does not support all repetition forms consistently; explicit length checked below.
    string(LENGTH "${_expected}" _hash_len)
    if(NOT _hash_len EQUAL 64 OR NOT _expected MATCHES "^[a-fA-F0-9]+$")
      message(FATAL_ERROR "Invalid SHA-256 metadata")
    endif()
  endif()
  file(SHA256 "${_lib}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Artifact integrity failure (SHA-256 mismatch): ${_lib}")
  endif()
  add_library(TelemetryCodec::TelemetryCodec STATIC IMPORTED GLOBAL)
  set_target_properties(TelemetryCodec::TelemetryCodec PROPERTIES
    IMPORTED_LOCATION "${_lib}"
    INTERFACE_INCLUDE_DIRECTORIES "${_inc}")
  message(STATUS "Verified teaching fixture: ${_recorded_id} sha256=${_actual}")
endfunction()
