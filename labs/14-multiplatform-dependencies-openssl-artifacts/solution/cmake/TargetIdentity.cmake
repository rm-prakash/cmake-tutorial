# Identity is based on TARGET properties, never the developer's host machine.
if(CMAKE_SYSTEM_NAME STREQUAL "Android")
  if(NOT ANDROID_ABI MATCHES "^(armeabi-v7a|arm64-v8a|x86_64)$")
    message(FATAL_ERROR "Unsupported Android ABI: ${ANDROID_ABI}")
  endif()
  set(EMBEDDEDCORE_TARGET_ID "android-${ANDROID_ABI}")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
  if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "This lesson supports only Windows x64")
  endif()
  set(EMBEDDEDCORE_TARGET_ID "windows-x64")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(EMBEDDEDCORE_TARGET_ID "linux-x86_64")
  else()
    message(FATAL_ERROR "Unsupported Linux target architecture: ${CMAKE_SYSTEM_PROCESSOR}")
  endif()
else()
  message(FATAL_ERROR "Unsupported target OS: ${CMAKE_SYSTEM_NAME}")
endif()
