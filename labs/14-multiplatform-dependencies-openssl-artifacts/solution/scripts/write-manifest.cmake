if(NOT DEFINED ROOT OR NOT DEFINED TARGET_ID OR NOT DEFINED LIB_NAME)
  message(FATAL_ERROR "Usage: cmake -DROOT=... -DTARGET_ID=... -DLIB_NAME=... -P write-manifest.cmake")
endif()
set(_lib "${ROOT}/lib/${LIB_NAME}")
if(NOT EXISTS "${_lib}")
  message(FATAL_ERROR "Staged static library missing: ${_lib}")
endif()
file(MAKE_DIRECTORY "${ROOT}/metadata")
file(SHA256 "${_lib}" _sha256)
file(WRITE "${ROOT}/metadata/target-id.txt" "${TARGET_ID}\n")
file(WRITE "${ROOT}/metadata/libsha256.txt" "${_sha256}\n")
message(STATUS "Fixture recorded: ${TARGET_ID}, sha256=${_sha256}")
